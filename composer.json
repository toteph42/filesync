		"file",
		"synchonisation",
		"contao"
	],
	"authors" : [{
			"name" : "Florian Daeumling",
			"role" : "Author",
			"email" : "toteph42@wb28.de"
		}
	],
	"funding" : [{
			"type" : "other",
			"url" : "https://www.paypal.com/donate/?hosted_button_id=DS6VK49NAFHEQ"
